# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Razorpay Credentials (must be set explicitly for real deployments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SIMULATION_MODE=false

# Google Sheets Configuration
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_PATH=path/to/service_account.json

# Admin Authentication
# Set a strong password hash and rotate secrets before deployment.
ADMIN_PASSWORD_HASH=
ADMIN_SECRET_KEY=
ATTEMPT_SECRET_KEY=

# SQLite Transactional Store (Authoritative Locks & States)
DATABASE_URL=sqlite:///./exam_manager.db

# Limits & Policies
MAX_QUESTIONS_PER_PAPER=100
MAX_OPTIONS_PER_QUESTION=8
MAX_QUESTION_TEXT_LENGTH=4000
MAX_OPTION_TEXT_LENGTH=1000
MAX_TEXT_ANSWER_LENGTH=500

