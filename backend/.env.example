# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Razorpay Credentials (set RAZORPAY_SIMULATION_MODE=false in production)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_sample_secret_key
RAZORPAY_SIMULATION_MODE=true

# Google Sheets Configuration
GOOGLE_SHEET_ID=sample_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_PATH=path/to/service_account.json

# Admin Authentication
# Default password in development is "Admin@12345"
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$salt12345678$c27db115b81ea6d9333333333333333333333333333333333333333333333333
ADMIN_SECRET_KEY=temporary_admin_secret_key_change_in_prod_at_least_32_chars
ATTEMPT_SECRET_KEY=temporary_attempt_secret_key_change_in_prod_at_least_32_chars

# SQLite Transactional Store (Authoritative Locks & States)
DATABASE_URL=sqlite:///./exam_manager.db

# Limits & Policies
MAX_QUESTIONS_PER_PAPER=100
MAX_OPTIONS_PER_QUESTION=8
MAX_QUESTION_TEXT_LENGTH=4000
MAX_OPTION_TEXT_LENGTH=1000
MAX_TEXT_ANSWER_LENGTH=500

